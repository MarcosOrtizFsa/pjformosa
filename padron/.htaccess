Options -Indexes
RewriteEngine On

# Nunca exponer archivos de configuración, volcados o documentación interna.
<FilesMatch "(?i)^(mysql_conect\.php|.*\.(sql|bak|log|ini|env))$">
  Require all denied
</FilesMatch>

# En producción conserva la ruta solicitada al forzar HTTPS.
RewriteCond %{HTTP_HOST} ^(?:www\.)?pjformosa\.com\.ar$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://pjformosa.com.ar%{REQUEST_URI} [L,R=301,NE]

RewriteRule ^sistema/([0-9]+)/([a-zA-Z0-9_-]{1,40})/?$ sistema/index.php?id_system_01=$1&system_01_modulo=$2 [L,QSA]
RewriteRule ^login/([0-9]{9,10})/(.{38,46})/([0-9]{9,10})/?$ sistema/php/valida.php?rr=$1&cc=$2&tt=$3 [L,QSA]
RewriteRule ^sistema/perfil/?$ sistema/index.php?mod=perfil [L,QSA]
RewriteRule ^login/?$ sistema/index.php?mod=login [L,QSA]
RewriteRule ^code/([0-9]{8})/?$ code_pdf.php?code=$1 [L,QSA]

